# API (Java). Copy to shell env or use with Docker -e / --env-file.
CITYFLOW_PORT=8080
CITYFLOW_DATA_DIR=data
# Comma-separated browser origins allowed for CORS (Vite + same-origin Docker UI)
CITYFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Set a shared secret for demos; leave empty for open local lab mode
CITYFLOW_API_KEY=
# Optional: serve Vite build from the API process
# CITYFLOW_STATIC_DIR=web/dist
CITYFLOW_MAX_BODY_BYTES=1048576
CITYFLOW_MAX_RUN_TICKS=200
CITYFLOW_MAX_COMPARE_TICKS=500
CITYFLOW_MAX_ROWS=32
CITYFLOW_MAX_COLS=32
CITYFLOW_MAX_FLEET=2000
CITYFLOW_MAX_RUSH=40
CITYFLOW_WORKER_THREADS=16
